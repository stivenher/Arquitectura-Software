@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Usuario\n(Conductor / Peatón)" as Usuario
actor "Sistema de Sensores" as Sensores
actor "Centro de Control" as Centro
actor "Servicios Externos\n(Mapas, Clima)" as Externos

rectangle "Sistema Inteligente de Movilidad Urbana" {

  usecase "Consultar\nRuta Óptima" as UC1
  usecase "Visualizar\nEstado del Tráfico" as UC2
  usecase "Recibir\nAlertas" as UC3
  usecase "Reportar\nIncidente" as UC4
  usecase "Gestionar\nSemáforos" as UC5
  usecase "Procesar Datos\nde Sensores" as UC6
  usecase "Detectar\nCongestión" as UC7
  usecase "Consultar\nMapas" as UC8
  usecase "Administrar\nSistema" as UC9

}

Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4

Sensores --> UC6

Centro --> UC5
Centro --> UC9

Externos --> UC8

UC1 ..> UC8 : <<include>>

UC2 ..> UC7 : <<include>>

UC3 ..> UC7 : <<include>>

UC5 ..> UC7 : <<include>>

UC7 ..> UC6 : <<include>>

@enduml